[General]
debootstrap=Jammy
aptsources=Jammy
arch=armhf
allowrecommends=false
addimportant=false

[Jammy]
source=http://ports.ubuntu.com/ubuntu-ports
suite=jammy universe
keyring=ubuntu-keyring

# Python3 scientific stack (minimal - only essential packages)
packages=python3-retrying
packages=python3-pil
packages=python3-setuptools python3-pip
packages=python3-wheel python3-netifaces
packages=python3-cffi
packages=python3-numpy

# Java RUNTIME (JRE, not JDK - saves ~200MB)
packages=openjdk-17-jre-headless

# Base system essentials
packages=adduser apt apt-utils attr
packages=base-files base-passwd bash
packages=bsdutils bzip2 ca-certificates
packages=coreutils cpufrequtils curl dash dbus
packages=debconf debianutils diffutils dpkg
packages=e2fsprogs ethtool file findutils
packages=gettext-base grep gzip
packages=hostname htop i2c-tools
packages=ifupdown init init-system-helpers
packages=iproute2 iputils-ping isc-dhcp-client isc-dhcp-common
packages=less
packages=libc-bin libc6
packages=libdbus-1-3 libdbus-glib-1-2
packages=libexpat1 libffi7
packages=libglib2.0-0 libglib2.0-bin libglib2.0-data
packages=libgpg-error0 libgcrypt20 libgnutls30
packages=libi2c0 libkeyutils1 libkmod2
packages=liblzma5 liblzo2-2
packages=libmagic1
packages=libmount1
packages=libncurses6 libncursesw6
packages=libpam-modules libpam-modules-bin libpam-runtime libpam-systemd libpam0g
packages=libpopt0 libprocps8
packages=libsasl2-2 libsasl2-modules libsasl2-modules-db libseccomp2
packages=libselinux1 libsemanage-common libsemanage2 libsepol2
packages=libsmartcols1 libsqlite3-0 libss2 libssl3
packages=libstdc++6 libsystemd0
packages=libtasn1-6
packages=libtinfo6
packages=libudev1 libuuid1
packages=locales login

# Network and SSH
packages=kmod mount
packages=ncurses-base ncurses-bin net-tools netbase
packages=openssh-client openssh-server openssh-sftp-server openssl
packages=rsync
packages=ssh

# System management
packages=passwd procps psmisc
packages=sed
packages=sudo systemd systemd-sysv sysvinit-utils tar
packages=tzdata ubuntu-keyring udev unzip
packages=usbutils util-linux
packages=vim-tiny wget
packages=xz-utils zlib1g

# Hardware tools (no WiFi tools - wired Ethernet only)
packages=devmem2 i2c-tools
packages=fake-hwclock haveged

# Python3 runtime
packages=python-is-python3 python-apt-common
packages=python3 python3-minimal python3-apt
packages=python3-dbus python3-six
packages=python3-pkg-resources

# OpenCV runtime libraries (NO -dev packages)
packages=libopencv-core4.5d libopencv-imgproc4.5d libopencv-imgcodecs4.5d
packages=libopencv-videoio4.5d libopencv-highgui4.5d
packages=libopencv-video4.5d libopencv-calib3d4.5d
packages=libopencv-features2d4.5d libopencv-flann4.5d

# Math/science runtime libraries (NO -dev packages)
packages=libatlas3-base libblas3 liblapack3
packages=libgoogle-glog0v5

# Utilities
packages=git
packages=mawk readline-common
packages=libcurl4 libxml2
packages=libusb-1.0-0 libftdi1
packages=libyaml-0-2

# Minimal lib dependencies
packages=libacl1 libattr1 libaudit1 libaudit-common
packages=libblkid1 libbsd0 libbz2-1.0
packages=libcap2 libcap2-bin libcap-ng0
packages=libcom-err2 libcrypt1
packages=libfdisk1 libgcc-s1 libgomp1
packages=libidn12 libidn2-0
packages=libmpdec3 libnettle8
packages=libp11-kit0 libpcre3 libpcre2-8-0
packages=libpython3-stdlib libpython3.10 libpython3.10-minimal libpython3.10-stdlib
packages=libreadline8
packages=libunistring2 libxxhash0 libzstd1
packages=python3.10 python3.10-minimal
packages=fdisk ubuntu-minimal usrmerge
